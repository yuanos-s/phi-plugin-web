# ===== TapTap =====
# TapTap OAuth client_id (默认值正确，可选覆盖)
# TAP_CLIENT_ID=rAK3FfdieFob2Nn8Am

# ===== Supabase =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# service_key 有更高权限 (admin操作)，可选
SUPABASE_SERVICE_KEY=your-service-key

# ===== 曲绘源 (可选) =====
# PHI_ILL_BASE=https://raw.githubusercontent.com/Catrong/phi-plugin-ill/main/ill
# PHI_ILL_PROXY=https://gh-proxy.com
