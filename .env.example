# ===== TapTap / LeanCloud =====
# TapTap OAuth client_id (= LeanCloud App ID)
# 默认值正确，无需修改；仅在确认需要覆盖时设置
# TAP_CLIENT_ID=rAK3FfdieFob2Nn8Am

# ===== Supabase =====
# 在 https://supabase.com 创建项目后获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ===== LeanCloud (可选覆盖) =====
# CN_LC_ID=rAK3FfdieFob2Nn8Am
# CN_LC_KEY=Qr9AEqtuoSVS3zeD6iVbM4ZC0AtkJcQ89tywVyi0
